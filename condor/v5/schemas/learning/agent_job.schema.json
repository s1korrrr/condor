            {
              "type": "null"
            }
          ],
          "title": "Asset"
        },
        "kind": {
          "enum": [
            "money",
            "quantity",
            "price",
            "probability",
            "ordinal",
            "simple_return",
            "log_return",
            "ratio",
            "rank",
            "z"
          ],
          "title": "Kind",
          "type": "string"
        },
        "quote_currency": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Quote Currency"
        },
        "unit": {
          "enum": [
            "quote_asset",
            "base_asset",
            "quote_per_base",
            "probability_0_1",
            "ordinal_score",
            "simple_return_fraction",
            "log_return",
            "dimensionless_ratio",
            "rank_index",
            "z_score"
          ],
          "title": "Unit",
          "type": "string"
        },
        "value": {
          "pattern": "^-?(?:0|[1-9][0-9]{0,29})(?:\\.[0-9]{1,30})?$",
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "unit",
        "value",
        "asset",
        "quote_currency"
      ],
      "title": "Quantity",
      "type": "object"
    },
