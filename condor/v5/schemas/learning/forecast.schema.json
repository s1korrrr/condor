{
  "$defs": {
    "CalibrationProvenance": {
      "additionalProperties": false,
      "properties": {
        "embargo_ms": {
          "maximum": 9223372036854775807,
          "minimum": 0,
          "title": "Embargo Ms",
          "type": "integer"
        },
        "eval_cohort_ref": {
          "$ref": "#/$defs/Reference"
        },
        "eval_start_ms": {
          "maximum": 9223372036854775807,
          "minimum": 0,
          "title": "Eval Start Ms",
          "type": "integer"
        },
        "fit_cohort_ref": {
          "$ref": "#/$defs/Reference"
        },
        "fit_end_ms": {
          "maximum": 9223372036854775807,
          "minimum": 0,
          "title": "Fit End Ms",
          "type": "integer"
        },
        "maturity": {
          "enum": [
            "MATURE",
            "IMMATURE",
            "UNKNOWN"
          ],
          "title": "Maturity",
          "type": "string"
        }
      },
      "required": [
        "fit_cohort_ref",
        "eval_cohort_ref",
        "fit_end_ms",
        "eval_start_ms",
        "embargo_ms",
        "maturity"
      ],
      "title": "CalibrationProvenance",
      "type": "object"
    },
    "ForecastOutput": {
      "additionalProperties": false,
      "properties": {
        "abstention_reason": {
          "anyOf": [
            {
              "maxLength": 4096,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Abstention Reason"
        },
        "kind": {
          "enum": [
            "POINT",
            "QUANTILES",
            "PATH",
            "PROBABILITY",
            "ABSTAIN"
          ],
          "title": "Kind",
          "type": "string"
        },
        "path_at_ms": {
          "items": {
            "maximum": 9223372036854775807,
            "minimum": 0,
            "type": "integer"
          },
          "maxItems": 512,
          "title": "Path At Ms",
          "type": "array"
        },
        "quantile_levels": {
          "items": {
            "pattern": "^-?(?:0|[1-9][0-9]{0,29})(?:\\.[0-9]{1,30})?$",
            "type": "string"
          },
          "maxItems": 512,
          "title": "Quantile Levels",
          "type": "array"
        },
        "values": {
          "items": {
            "$ref": "#/$defs/Quantity"
          },
          "maxItems": 512,
          "title": "Values",
          "type": "array"
        }
      },
      "required": [
        "kind",
        "values",
        "quantile_levels",
        "path_at_ms",
        "abstention_reason"
      ],
      "title": "ForecastOutput",
      "type": "object"
    },
    "Quantity": {
      "additionalProperties": false,
      "properties": {
        "asset": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Asset"
        },
        "kind": {
          "enum": [
            "money",
            "quantity",
            "price",
            "probability",
            "ordinal",
            "simple_return",
            "log_return",
            "ratio",
            "rank",
            "z"
          ],
          "title": "Kind",
          "type": "string"
        },
        "quote_currency": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Quote Currency"
        },
        "unit": {
          "enum": [
            "quote_asset",
            "base_asset",
            "quote_per_base",
            "probability_0_1",
            "ordinal_score",
            "simple_return_fraction",
            "log_return",
            "dimensionless_ratio",
            "rank_index",
            "z_score"
          ],
          "title": "Unit",
          "type": "string"
        },
        "value": {
          "pattern": "^-?(?:0|[1-9][0-9]{0,29})(?:\\.[0-9]{1,30})?$",
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "unit",
        "value",
        "asset",
        "quote_currency"
      ],
      "title": "Quantity",
      "type": "object"
    },
    "Reference": {
      "additionalProperties": false,
      "properties": {
        "available_at_ms": {
          "maximum": 9223372036854775807,
          "minimum": 0,
          "title": "Available At Ms",
          "type": "integer"
        },
        "content_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Content Sha256",
          "type": "string"
        },
        "owner": {
          "enum": [
            "research_os",
            "hummingbot",
            "hummingbot_api",
            "quants_lab"
          ],
          "title": "Owner",
          "type": "string"
        },
        "record_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
          "title": "Record Id",
          "type": "string"
        },
        "record_kind": {
          "enum": [
            "candidate_revision",
            "opportunity",
            "agent_job",
            "agent_message",
            "event",
            "forecast",
            "forecast_evaluation",
            "experience_ref",
            "lesson_revision",
            "retraction",
            "knowledge_release",
            "adoption",
            "evidence",
            "input_snapshot",
            "inventory",
            "critic_receipt",
            "model",
            "calibrator",
            "candidate_library",
            "program",
            "idea_revision",
            "native_receipt",
            "outcome",
            "policy",
            "experiment",
            "run",
            "assessment",
            "metrics",
            "report",
            "artifact_bundle",
            "campaign",
            "job_admission",
            "strategy_selection_proposal",
            "feature",
            "regime",
            "target",
            "prompt",
            "skill",
            "retrieval_index",
            "rights_retraction",
            "source"
          ],
          "title": "Record Kind",
          "type": "string"
        },
        "revision": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
          "title": "Revision",
          "type": "string"
        }
      },
      "required": [
        "owner",
        "record_kind",
        "record_id",
        "revision",
        "content_sha256",
        "available_at_ms"
      ],
      "title": "Reference",
      "type": "object"
    },
    "Scope": {
      "additionalProperties": false,
      "properties": {
        "connector": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
          "title": "Connector",
          "type": "string"
        },
        "horizon_ms": {
          "maximum": 9223372036854775807,
          "minimum": 1,
          "title": "Horizon Ms",
          "type": "integer"
        },
        "instruments": {
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
            "type": "string"
          },
          "maxItems": 64,
          "minItems": 1,
          "title": "Instruments",
          "type": "array"
        },
        "lane": {
          "const": "spot",
          "title": "Lane",
          "type": "string"
        },
        "mandate_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
          "title": "Mandate Id",
          "type": "string"
        },
        "quote_currency": {
          "pattern": "^[A-Z0-9]{2,16}$",
          "title": "Quote Currency",
          "type": "string"
        },
        "regime_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
          "title": "Regime Id",
          "type": "string"
        },
        "timeframe": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
          "title": "Timeframe",
          "type": "string"
        },
        "venue": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
          "title": "Venue",
          "type": "string"
        }
      },
      "required": [
        "lane",
        "venue",
        "connector",
        "instruments",
        "quote_currency",
        "timeframe",
        "horizon_ms",
        "regime_id",
        "mandate_id"
      ],
      "title": "Scope",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "available_at_ms": {
      "maximum": 9223372036854775807,
      "minimum": 0,
      "title": "Available At Ms",
      "type": "integer"
    },
    "correlation_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
      "title": "Correlation Id",
      "type": "string"
    },
    "created_at_ms": {
      "maximum": 9223372036854775807,
      "minimum": 0,
      "title": "Created At Ms",
      "type": "integer"
    },
    "data": {
      "additionalProperties": false,
      "properties": {
        "calibration": {
          "enum": [
            "UNCALIBRATED",
            "FIXTURE_ONLY",
            "CALIBRATED"
          ],
          "title": "Calibration",
          "type": "string"
        },
        "calibration_provenance": {
          "anyOf": [
            {
              "$ref": "#/$defs/CalibrationProvenance"
            },
            {
              "type": "null"
            }
          ]
        },
        "calibrator_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reference"
            },
            {
              "type": "null"
            }
          ]
        },
        "checkpoint_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Checkpoint Sha256",
          "type": "string"
        },
        "decision_at_ms": {
          "maximum": 9223372036854775807,
          "minimum": 0,
          "title": "Decision At Ms",
          "type": "integer"
        },
        "decision_cutoff_ms": {
          "maximum": 9223372036854775807,
          "minimum": 0,
          "title": "Decision Cutoff Ms",
          "type": "integer"
        },
        "expires_at_ms": {
          "maximum": 9223372036854775807,
          "minimum": 0,
          "title": "Expires At Ms",
          "type": "integer"
        },
        "generation_completed_at_ms": {
          "maximum": 9223372036854775807,
          "minimum": 0,
          "title": "Generation Completed At Ms",
          "type": "integer"
        },
        "generation_started_at_ms": {
          "maximum": 9223372036854775807,
          "minimum": 0,
          "title": "Generation Started At Ms",
          "type": "integer"
        },
        "label_end_ms": {
          "maximum": 9223372036854775807,
          "minimum": 0,
          "title": "Label End Ms",
          "type": "integer"
        },
        "label_policy_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Label Policy Sha256",
          "type": "string"
        },
        "missingness": {
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
            "type": "string"
          },
          "maxItems": 64,
          "title": "Missingness",
          "type": "array"
        },
        "model_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reference"
            },
            {
              "type": "null"
            }
          ]
        },
        "ordered_input_hashes": {
          "items": {
            "pattern": "^[a-f0-9]{64}$",
            "type": "string"
          },
          "maxItems": 64,
          "title": "Ordered Input Hashes",
          "type": "array"
        },
        "output": {
          "$ref": "#/$defs/ForecastOutput"
        },
        "prediction": {
          "anyOf": [
            {
              "$ref": "#/$defs/Quantity"
            },
            {
              "type": "null"
            }
          ]
        },
        "rights_policy_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Rights Policy Sha256",
          "type": "string"
        },
        "runtime_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Runtime Sha256",
          "type": "string"
        },
        "scope": {
          "$ref": "#/$defs/Scope"
        },
        "settings_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Settings Sha256",
          "type": "string"
        },
        "target_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
          "title": "Target Id",
          "type": "string"
        },
        "target_ref": {
          "$ref": "#/$defs/Reference"
        },
        "target_version": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
          "title": "Target Version",
          "type": "string"
        },
        "tokenizer_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Tokenizer Sha256",
          "type": "string"
        },
        "training_overlap": {
          "enum": [
            "UNKNOWN",
            "FIXTURE_ONLY"
          ],
          "title": "Training Overlap",
          "type": "string"
        }
      },
      "required": [
        "decision_cutoff_ms",
        "decision_at_ms",
        "expires_at_ms",
        "target_id",
        "target_version",
        "target_ref",
        "scope",
        "label_policy_sha256",
        "label_end_ms",
        "ordered_input_hashes",
        "missingness",
        "model_ref",
        "calibrator_ref",
        "checkpoint_sha256",
        "tokenizer_sha256",
        "settings_sha256",
        "runtime_sha256",
        "generation_started_at_ms",
        "generation_completed_at_ms",
        "prediction",
        "output",
        "calibration",
        "calibration_provenance",
        "training_overlap",
        "rights_policy_sha256"
      ],
      "title": "Forecast",
      "type": "object"
    },
    "evidence_refs": {
      "items": {
        "$ref": "#/$defs/Reference"
      },
      "maxItems": 64,
      "title": "Evidence Refs",
      "type": "array"
    },
    "execution_authorized": {
      "const": false,
      "title": "Execution Authorized",
      "type": "boolean"
    },
    "parent_refs": {
      "items": {
        "$ref": "#/$defs/Reference"
      },
      "maxItems": 64,
      "title": "Parent Refs",
      "type": "array"
    },
    "payload_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Payload Sha256",
      "type": "string"
    },
    "producer_owner": {
      "const": "quants_lab",
      "type": "string"
    },
    "producer_revision": {
      "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$",
      "title": "Producer Revision",
      "type": "string"
    },
    "record_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
      "title": "Record Id",
      "type": "string"
    },
    "schema_name": {
      "const": "forecast",
      "type": "string"
    },
    "schema_version": {
      "const": "1",
      "type": "string"
    }
  },
  "required": [
    "schema_name",
    "schema_version",
    "record_id",
    "producer_owner",
    "producer_revision",
    "created_at_ms",
    "available_at_ms",
    "payload_sha256",
    "correlation_id",
    "parent_refs",
    "evidence_refs",
    "execution_authorized",
    "data"
  ],
  "title": "Envelope",
  "type": "object"
}
