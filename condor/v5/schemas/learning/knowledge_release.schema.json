{
  "$defs": {
    "ComponentBinding": {
      "additionalProperties": false,
      "properties": {
        "absence_reason": {
          "anyOf": [
            {
              "maxLength": 4096,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Absence Reason"
        },
        "refs": {
          "items": {
            "$ref": "#/$defs/Reference"
          },
          "maxItems": 64,
          "title": "Refs",
          "type": "array"
        }
      },
      "required": [
        "refs",
        "absence_reason"
      ],
      "title": "ComponentBinding",
      "type": "object"
    },
    "ConsumerManifest": {
      "additionalProperties": false,
      "properties": {
        "calibrators": {
          "$ref": "#/$defs/ComponentBinding"
        },
        "candidate_library_ref": {
          "$ref": "#/$defs/Reference"
        },
        "features": {
          "$ref": "#/$defs/ComponentBinding"
        },
        "models": {
          "$ref": "#/$defs/ComponentBinding"
        },
        "prompts": {
          "$ref": "#/$defs/ComponentBinding"
        },
        "regimes": {
          "$ref": "#/$defs/ComponentBinding"
        },
        "retrieval_index_ref": {
          "$ref": "#/$defs/Reference"
        },
        "rights_retraction_ref": {
          "$ref": "#/$defs/Reference"
        },
        "skills": {
          "$ref": "#/$defs/ComponentBinding"
        },
        "targets": {
          "$ref": "#/$defs/ComponentBinding"
        }
      },
      "required": [
        "candidate_library_ref",
        "models",
        "features",
        "regimes",
        "targets",
        "prompts",
        "skills",
        "calibrators",
        "retrieval_index_ref",
        "rights_retraction_ref"
      ],
      "title": "ConsumerManifest",
      "type": "object"
    },
    "ForecastTargetBinding": {
      "additionalProperties": false,
      "properties": {
        "forecast_ref": {
          "$ref": "#/$defs/Reference"
        },
        "target_ref": {
          "$ref": "#/$defs/Reference"
        }
      },
      "required": [
        "forecast_ref",
        "target_ref"
      ],
      "title": "ForecastTargetBinding",
      "type": "object"
    },
    "Reference": {
      "additionalProperties": false,
      "properties": {
        "available_at_ms": {
          "maximum": 9223372036854775807,
          "minimum": 0,
          "title": "Available At Ms",
          "type": "integer"
        },
        "content_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Content Sha256",
          "type": "string"
        },
        "owner": {
          "enum": [
            "research_os",
            "hummingbot",
            "hummingbot_api",
            "quants_lab"
          ],
          "title": "Owner",
          "type": "string"
        },
        "record_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
          "title": "Record Id",
          "type": "string"
        },
        "record_kind": {
          "enum": [
            "candidate_revision",
            "opportunity",
            "agent_job",
            "agent_message",
            "event",
            "forecast",
            "forecast_evaluation",
            "experience_ref",
            "lesson_revision",
            "retraction",
            "knowledge_release",
            "adoption",
            "evidence",
            "input_snapshot",
            "inventory",
            "critic_receipt",
            "model",
            "calibrator",
            "candidate_library",
            "program",
            "idea_revision",
            "native_receipt",
            "outcome",
            "policy",
            "experiment",
            "run",
            "assessment",
            "metrics",
            "report",
            "artifact_bundle",
            "campaign",
            "job_admission",
            "strategy_selection_proposal",
            "feature",
            "regime",
            "target",
            "prompt",
            "skill",
            "retrieval_index",
            "rights_retraction",
            "source"
          ],
          "title": "Record Kind",
          "type": "string"
        },
        "revision": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
          "title": "Revision",
          "type": "string"
        }
      },
      "required": [
        "owner",
        "record_kind",
        "record_id",
        "revision",
        "content_sha256",
        "available_at_ms"
      ],
      "title": "Reference",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "available_at_ms": {
      "maximum": 9223372036854775807,
      "minimum": 0,
      "title": "Available At Ms",
      "type": "integer"
    },
    "correlation_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
      "title": "Correlation Id",
      "type": "string"
    },
    "created_at_ms": {
      "maximum": 9223372036854775807,
      "minimum": 0,
      "title": "Created At Ms",
      "type": "integer"
    },
    "data": {
      "additionalProperties": false,
      "properties": {
        "authority_generation": {
          "maximum": 9223372036854775807,
          "minimum": 0,
          "title": "Authority Generation",
          "type": "integer"
        },
        "calibrator_refs": {
          "items": {
            "$ref": "#/$defs/Reference"
          },
          "maxItems": 64,
          "title": "Calibrator Refs",
          "type": "array"
        },
        "candidate_refs": {
          "items": {
            "$ref": "#/$defs/Reference"
          },
          "maxItems": 64,
          "title": "Candidate Refs",
          "type": "array"
        },
        "consumer_manifest": {
          "$ref": "#/$defs/ConsumerManifest"
        },
        "dependency_closure_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Dependency Closure Sha256",
          "type": "string"
        },
        "forecast_refs": {
          "items": {
            "$ref": "#/$defs/Reference"
          },
          "maxItems": 64,
          "title": "Forecast Refs",
          "type": "array"
        },
        "forecast_target_bindings": {
          "items": {
            "$ref": "#/$defs/ForecastTargetBinding"
          },
          "maxItems": 256,
          "title": "Forecast Target Bindings",
          "type": "array"
        },
        "graph_generation_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Graph Generation Sha256",
          "type": "string"
        },
        "lesson_refs": {
          "items": {
            "$ref": "#/$defs/Reference"
          },
          "maxItems": 64,
          "title": "Lesson Refs",
          "type": "array"
        },
        "manifest_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Manifest Sha256",
          "type": "string"
        },
        "parent_release_id": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Parent Release Id"
        },
        "parent_release_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reference"
            },
            {
              "type": "null"
            }
          ]
        },
        "policy_revision_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Policy Revision Sha256",
          "type": "string"
        },
        "prompt_revision_hashes": {
          "items": {
            "pattern": "^[a-f0-9]{64}$",
            "type": "string"
          },
          "maxItems": 64,
          "title": "Prompt Revision Hashes",
          "type": "array"
        },
        "release_effective_at_ms": {
          "maximum": 9223372036854775807,
          "minimum": 0,
          "title": "Release Effective At Ms",
          "type": "integer"
        },
        "release_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
          "title": "Release Id",
          "type": "string"
        },
        "required_consumer_versions": {
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
            "type": "string"
          },
          "maxItems": 64,
          "title": "Required Consumer Versions",
          "type": "array"
        },
        "retraction_digest": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Retraction Digest",
          "type": "string"
        },
        "retrieval_index_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Retrieval Index Sha256",
          "type": "string"
        },
        "review_refs": {
          "items": {
            "$ref": "#/$defs/Reference"
          },
          "maxItems": 64,
          "title": "Review Refs",
          "type": "array"
        },
        "rights_version": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Rights Version",
          "type": "string"
        },
        "role_revision_hashes": {
          "items": {
            "pattern": "^[a-f0-9]{64}$",
            "type": "string"
          },
          "maxItems": 64,
          "title": "Role Revision Hashes",
          "type": "array"
        },
        "schema_digests": {
          "items": {
            "pattern": "^[a-f0-9]{64}$",
            "type": "string"
          },
          "maxItems": 64,
          "title": "Schema Digests",
          "type": "array"
        },
        "scope_of_use": {
          "enum": [
            "research",
            "advisory"
          ],
          "title": "Scope Of Use",
          "type": "string"
        },
        "skill_revision_hashes": {
          "items": {
            "pattern": "^[a-f0-9]{64}$",
            "type": "string"
          },
          "maxItems": 64,
          "title": "Skill Revision Hashes",
          "type": "array"
        },
        "state": {
          "enum": [
            "DRAFT",
            "VALIDATED",
            "PUBLISHED",
            "SUPERSEDED",
            "REVOKED"
          ],
          "title": "State",
          "type": "string"
        }
      },
      "required": [
        "release_id",
        "parent_release_id",
        "parent_release_ref",
        "consumer_manifest",
        "manifest_sha256",
        "lesson_refs",
        "candidate_refs",
        "forecast_refs",
        "calibrator_refs",
        "graph_generation_sha256",
        "policy_revision_sha256",
        "role_revision_hashes",
        "prompt_revision_hashes",
        "skill_revision_hashes",
        "schema_digests",
        "retrieval_index_sha256",
        "dependency_closure_sha256",
        "retraction_digest",
        "rights_version",
        "authority_generation",
        "review_refs",
        "release_effective_at_ms",
        "required_consumer_versions",
        "scope_of_use",
        "state"
      ],
      "title": "KnowledgeRelease",
      "type": "object"
    },
    "evidence_refs": {
      "items": {
        "$ref": "#/$defs/Reference"
      },
      "maxItems": 64,
      "title": "Evidence Refs",
      "type": "array"
    },
    "execution_authorized": {
      "const": false,
      "title": "Execution Authorized",
      "type": "boolean"
    },
    "parent_refs": {
      "items": {
        "$ref": "#/$defs/Reference"
      },
      "maxItems": 64,
      "title": "Parent Refs",
      "type": "array"
    },
    "payload_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Payload Sha256",
      "type": "string"
    },
    "producer_owner": {
      "const": "research_os",
      "type": "string"
    },
    "producer_revision": {
      "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$",
      "title": "Producer Revision",
      "type": "string"
    },
    "record_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
      "title": "Record Id",
      "type": "string"
    },
    "schema_name": {
      "const": "knowledge_release",
      "type": "string"
    },
    "schema_version": {
      "const": "1",
      "type": "string"
    }
  },
  "required": [
    "schema_name",
    "schema_version",
    "record_id",
    "producer_owner",
    "producer_revision",
    "created_at_ms",
    "available_at_ms",
    "payload_sha256",
    "correlation_id",
    "parent_refs",
    "evidence_refs",
    "execution_authorized",
    "data"
  ],
  "title": "Envelope",
  "type": "object"
}
