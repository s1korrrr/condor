{
  "$defs": {
    "Reference": {
      "additionalProperties": false,
      "properties": {
        "available_at_ms": {
          "maximum": 9223372036854775807,
          "minimum": 0,
          "title": "Available At Ms",
          "type": "integer"
        },
        "content_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Content Sha256",
          "type": "string"
        },
        "owner": {
          "enum": [
            "research_os",
            "hummingbot",
            "hummingbot_api",
            "quants_lab"
          ],
          "title": "Owner",
          "type": "string"
        },
        "record_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
          "title": "Record Id",
          "type": "string"
        },
        "record_kind": {
          "enum": [
            "candidate_revision",
            "opportunity",
            "agent_job",
            "agent_message",
            "event",
            "forecast",
            "forecast_evaluation",
            "experience_ref",
            "lesson_revision",
            "retraction",
            "knowledge_release",
            "adoption",
            "evidence",
            "input_snapshot",
            "inventory",
            "critic_receipt",
            "model",
            "calibrator",
            "candidate_library",
            "program",
            "idea_revision",
            "native_receipt",
            "outcome",
            "policy",
            "experiment",
            "run",
            "assessment",
            "metrics",
            "report",
            "artifact_bundle",
            "campaign",
            "job_admission",
            "strategy_selection_proposal",
            "feature",
            "regime",
            "target",
            "prompt",
            "skill",
            "retrieval_index",
            "rights_retraction",
            "source"
          ],
          "title": "Record Kind",
          "type": "string"
        },
        "revision": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
          "title": "Revision",
          "type": "string"
        }
      },
      "required": [
        "owner",
        "record_kind",
        "record_id",
        "revision",
        "content_sha256",
        "available_at_ms"
      ],
      "title": "Reference",
      "type": "object"
    },
    "Scope": {
      "additionalProperties": false,
      "properties": {
        "connector": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
          "title": "Connector",
          "type": "string"
        },
        "horizon_ms": {
          "maximum": 9223372036854775807,
          "minimum": 1,
          "title": "Horizon Ms",
          "type": "integer"
        },
        "instruments": {
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
            "type": "string"
          },
          "maxItems": 64,
          "minItems": 1,
          "title": "Instruments",
          "type": "array"
        },
        "lane": {
          "const": "spot",
          "title": "Lane",
          "type": "string"
        },
        "mandate_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
          "title": "Mandate Id",
          "type": "string"
        },
        "quote_currency": {
          "pattern": "^[A-Z0-9]{2,16}$",
          "title": "Quote Currency",
          "type": "string"
        },
        "regime_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
          "title": "Regime Id",
          "type": "string"
        },
        "timeframe": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
          "title": "Timeframe",
          "type": "string"
        },
        "venue": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
          "title": "Venue",
          "type": "string"
        }
      },
      "required": [
        "lane",
        "venue",
        "connector",
        "instruments",
        "quote_currency",
        "timeframe",
        "horizon_ms",
        "regime_id",
        "mandate_id"
      ],
      "title": "Scope",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "available_at_ms": {
      "maximum": 9223372036854775807,
      "minimum": 0,
      "title": "Available At Ms",
      "type": "integer"
    },
    "correlation_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
      "title": "Correlation Id",
      "type": "string"
    },
    "created_at_ms": {
      "maximum": 9223372036854775807,
      "minimum": 0,
      "title": "Created At Ms",
      "type": "integer"
    },
    "data": {
      "additionalProperties": false,
      "properties": {
        "applicability_predicate_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
          "title": "Applicability Predicate Id",
          "type": "string"
        },
        "causal_target": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
          "title": "Causal Target",
          "type": "string"
        },
        "claim": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "Claim",
          "type": "string"
        },
        "condition": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "Condition",
          "type": "string"
        },
        "contradictory_refs": {
          "items": {
            "$ref": "#/$defs/Reference"
          },
          "maxItems": 64,
          "title": "Contradictory Refs",
          "type": "array"
        },
        "effect": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "Effect",
          "type": "string"
        },
        "evaluator_revision": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Evaluator Revision",
          "type": "string"
        },
        "evidence_validity": {
          "enum": [
            "VALID",
            "PROVISIONAL",
            "UNAVAILABLE",
            "INVALID"
          ],
          "title": "Evidence Validity",
          "type": "string"
        },
        "invalidation_predicate_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
          "title": "Invalidation Predicate Id",
          "type": "string"
        },
        "lesson_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
          "title": "Lesson Id",
          "type": "string"
        },
        "lifecycle_state": {
          "enum": [
            "PROPOSED",
            "UNDER_REVIEW",
            "QUALIFIED_FOR_RELEASE",
            "PUBLISHED",
            "SUSPENDED",
            "RETRACTED",
            "SUPERSEDED"
          ],
          "title": "Lifecycle State",
          "type": "string"
        },
        "permitted_uses": {
          "items": {
            "enum": [
              "research",
              "advisory"
            ],
            "type": "string"
          },
          "maxItems": 2,
          "minItems": 1,
          "title": "Permitted Uses",
          "type": "array"
        },
        "proposed_consequence": {
          "enum": [
            "RESEARCH_ONLY",
            "ADVISORY_CONTEXT"
          ],
          "title": "Proposed Consequence",
          "type": "string"
        },
        "release_eligible": {
          "title": "Release Eligible",
          "type": "boolean"
        },
        "retraction_refs": {
          "items": {
            "$ref": "#/$defs/Reference"
          },
          "maxItems": 64,
          "title": "Retraction Refs",
          "type": "array"
        },
        "reviewer_ids": {
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
            "type": "string"
          },
          "maxItems": 64,
          "title": "Reviewer Ids",
          "type": "array"
        },
        "revision": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
          "title": "Revision",
          "type": "string"
        },
        "scope": {
          "$ref": "#/$defs/Scope"
        },
        "search_exposure_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Search Exposure Sha256",
          "type": "string"
        },
        "supersession_refs": {
          "items": {
            "$ref": "#/$defs/Reference"
          },
          "maxItems": 64,
          "title": "Supersession Refs",
          "type": "array"
        },
        "support_refs": {
          "items": {
            "$ref": "#/$defs/Reference"
          },
          "maxItems": 64,
          "title": "Support Refs",
          "type": "array"
        }
      },
      "required": [
        "lesson_id",
        "revision",
        "claim",
        "effect",
        "condition",
        "causal_target",
        "support_refs",
        "contradictory_refs",
        "scope",
        "applicability_predicate_id",
        "invalidation_predicate_id",
        "reviewer_ids",
        "evaluator_revision",
        "search_exposure_sha256",
        "proposed_consequence",
        "permitted_uses",
        "evidence_validity",
        "lifecycle_state",
        "release_eligible",
        "supersession_refs",
        "retraction_refs"
      ],
      "title": "LessonRevision",
      "type": "object"
    },
    "evidence_refs": {
      "items": {
        "$ref": "#/$defs/Reference"
      },
      "maxItems": 64,
      "title": "Evidence Refs",
      "type": "array"
    },
    "execution_authorized": {
      "const": false,
      "title": "Execution Authorized",
      "type": "boolean"
    },
    "parent_refs": {
      "items": {
        "$ref": "#/$defs/Reference"
      },
      "maxItems": 64,
      "title": "Parent Refs",
      "type": "array"
    },
    "payload_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Payload Sha256",
      "type": "string"
    },
    "producer_owner": {
      "const": "research_os",
      "type": "string"
    },
    "producer_revision": {
      "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$",
      "title": "Producer Revision",
      "type": "string"
    },
    "record_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
      "title": "Record Id",
      "type": "string"
    },
    "schema_name": {
      "const": "lesson_revision",
      "type": "string"
    },
    "schema_version": {
      "const": "2",
      "type": "string"
    }
  },
  "required": [
    "schema_name",
    "schema_version",
    "record_id",
    "producer_owner",
    "producer_revision",
    "created_at_ms",
    "available_at_ms",
    "payload_sha256",
    "correlation_id",
    "parent_refs",
    "evidence_refs",
    "execution_authorized",
    "data"
  ],
  "title": "Envelope",
  "type": "object"
}
