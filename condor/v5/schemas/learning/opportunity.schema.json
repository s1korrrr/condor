{
  "$defs": {
    "Quantity": {
      "additionalProperties": false,
      "properties": {
        "asset": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Asset"
        },
        "kind": {
          "enum": [
            "money",
            "quantity",
            "price",
            "probability",
            "ordinal",
            "simple_return",
            "log_return",
            "ratio",
            "rank",
            "z"
          ],
          "title": "Kind",
          "type": "string"
        },
        "quote_currency": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Quote Currency"
        },
        "unit": {
          "enum": [
            "quote_asset",
            "base_asset",
            "quote_per_base",
            "probability_0_1",
            "ordinal_score",
            "simple_return_fraction",
            "log_return",
            "dimensionless_ratio",
            "rank_index",
            "z_score"
          ],
          "title": "Unit",
          "type": "string"
        },
        "value": {
          "pattern": "^-?(?:0|[1-9][0-9]{0,29})(?:\\.[0-9]{1,30})?$",
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "unit",
        "value",
        "asset",
        "quote_currency"
      ],
      "title": "Quantity",
      "type": "object"
    },
    "Reference": {
      "additionalProperties": false,
      "properties": {
        "available_at_ms": {
          "maximum": 9223372036854775807,
          "minimum": 0,
          "title": "Available At Ms",
          "type": "integer"
        },
        "content_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Content Sha256",
          "type": "string"
        },
        "owner": {
          "enum": [
            "research_os",
            "hummingbot",
            "hummingbot_api",
            "quants_lab"
          ],
          "title": "Owner",
          "type": "string"
        },
        "record_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
          "title": "Record Id",
          "type": "string"
        },
        "record_kind": {
          "enum": [
            "candidate_revision",
            "opportunity",
            "agent_job",
            "agent_message",
            "event",
            "forecast",
            "forecast_evaluation",
            "experience_ref",
            "lesson_revision",
            "retraction",
            "knowledge_release",
            "adoption",
            "evidence",
            "input_snapshot",
            "inventory",
            "critic_receipt",
            "model",
            "calibrator",
            "candidate_library",
            "program",
            "idea_revision",
            "native_receipt",
            "outcome",
            "policy",
            "experiment",
            "run",
            "assessment",
            "metrics",
            "report",
            "artifact_bundle",
            "campaign",
            "job_admission",
            "strategy_selection_proposal",
            "feature",
            "regime",
            "target",
            "prompt",
            "skill",
            "retrieval_index",
            "rights_retraction",
            "source"
          ],
          "title": "Record Kind",
          "type": "string"
        },
        "revision": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
          "title": "Revision",
          "type": "string"
        }
      },
      "required": [
        "owner",
        "record_kind",
        "record_id",
        "revision",
        "content_sha256",
        "available_at_ms"
      ],
      "title": "Reference",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "available_at_ms": {
      "maximum": 9223372036854775807,
      "minimum": 0,
      "title": "Available At Ms",
      "type": "integer"
    },
    "correlation_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
      "title": "Correlation Id",
      "type": "string"
    },
    "created_at_ms": {
      "maximum": 9223372036854775807,
      "minimum": 0,
      "title": "Created At Ms",
      "type": "integer"
    },
    "data": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "enum": [
            "ENTER",
            "ADD",
            "EXIT",
            "EXIT_REQUEST",
            "HOLD",
            "ABSTAIN"
          ],
          "title": "Action",
          "type": "string"
        },
        "candidate_ref": {
          "$ref": "#/$defs/Reference"
        },
        "decision_at_ms": {
          "maximum": 9223372036854775807,
          "minimum": 0,
          "title": "Decision At Ms",
          "type": "integer"
        },
        "decision_cutoff_ms": {
          "maximum": 9223372036854775807,
          "minimum": 0,
          "title": "Decision Cutoff Ms",
          "type": "integer"
        },
        "disposition": {
          "enum": [
            "SELECTED",
            "SKIPPED",
            "NO_SIGNAL",
            "SOURCE_FAILURE",
            "REFUSED",
            "NO_FILL"
          ],
          "title": "Disposition",
          "type": "string"
        },
        "expected_cost": {
          "$ref": "#/$defs/Quantity"
        },
        "expires_at_ms": {
          "maximum": 9223372036854775807,
          "minimum": 0,
          "title": "Expires At Ms",
          "type": "integer"
        },
        "horizon_ms": {
          "minimum": 1,
          "title": "Horizon Ms",
          "type": "integer"
        },
        "input_snapshot_ref": {
          "$ref": "#/$defs/Reference"
        },
        "inventory_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reference"
            },
            {
              "type": "null"
            }
          ]
        },
        "missing_data_flags": {
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
            "type": "string"
          },
          "maxItems": 64,
          "title": "Missing Data Flags",
          "type": "array"
        },
        "reason": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        },
        "required_quote": {
          "$ref": "#/$defs/Quantity"
        },
        "score": {
          "$ref": "#/$defs/Quantity"
        },
        "side": {
          "enum": [
            "BUY",
            "SELL",
            "NONE"
          ],
          "title": "Side",
          "type": "string"
        },
        "trajectory": {
          "enum": [
            "OBSERVED",
            "INDEPENDENT_SHADOW",
            "COUNTERFACTUAL"
          ],
          "title": "Trajectory",
          "type": "string"
        },
        "uncertainty": {
          "anyOf": [
            {
              "$ref": "#/$defs/Quantity"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "decision_cutoff_ms",
        "decision_at_ms",
        "expires_at_ms",
        "candidate_ref",
        "input_snapshot_ref",
        "inventory_ref",
        "action",
        "side",
        "horizon_ms",
        "required_quote",
        "expected_cost",
        "score",
        "uncertainty",
        "missing_data_flags",
        "disposition",
        "reason",
        "trajectory"
      ],
      "title": "Opportunity",
      "type": "object"
    },
    "evidence_refs": {
      "items": {
        "$ref": "#/$defs/Reference"
      },
      "maxItems": 64,
      "title": "Evidence Refs",
      "type": "array"
    },
    "execution_authorized": {
      "const": false,
      "title": "Execution Authorized",
      "type": "boolean"
    },
    "parent_refs": {
      "items": {
        "$ref": "#/$defs/Reference"
      },
      "maxItems": 64,
      "title": "Parent Refs",
      "type": "array"
    },
    "payload_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Payload Sha256",
      "type": "string"
    },
    "producer_owner": {
      "const": "hummingbot",
      "type": "string"
    },
    "producer_revision": {
      "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$",
      "title": "Producer Revision",
      "type": "string"
    },
    "record_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
      "title": "Record Id",
      "type": "string"
    },
    "schema_name": {
      "const": "opportunity",
      "type": "string"
    },
    "schema_version": {
      "const": "1",
      "type": "string"
    }
  },
  "required": [
    "schema_name",
    "schema_version",
    "record_id",
    "producer_owner",
    "producer_revision",
    "created_at_ms",
    "available_at_ms",
    "payload_sha256",
    "correlation_id",
    "parent_refs",
    "evidence_refs",
    "execution_authorized",
    "data"
  ],
  "title": "Envelope",
  "type": "object"
}
