{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:rsibot:v5-lfl:stage-a:r2:common",
  "$defs": {
    "Id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^(?=.*\\S)[^\\u0000-\\u001f\\u007f]+$",
      "x-maxUtf8Bytes": 160
    },
    "Hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "Counter": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "TimeMs": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "Status": {
      "enum": [
        "BOUND",
        "PARTIAL",
        "UNAVAILABLE"
      ]
    },
    "RowStatus": {
      "enum": [
        "COMPLETE",
        "PARTIAL",
        "UNAVAILABLE"
      ]
    },
    "ReasonCodes": {
      "type": "array",
      "items": {
        "enum": [
          "MISSING_SOURCE",
          "SOURCE_CHANGED",
          "SCOPE_UNKNOWN",
          "UNSUPPORTED_NATIVE_SCHEMA",
          "OMITTED_CONTENT",
          "UNRESOLVED_REFERENCE",
          "CONTRADICTIONS_NOT_INDEXED",
          "COMPLETION_NOT_RECORDED",
          "INDEX_INCOMPLETE",
          "NOT_PUBLISHED",
          "CLOCK_SKEW",
          "INVALID_QUERY",
          "INVALID_CURSOR",
          "ROOT_NOT_IN_SCOPE",
          "DATASET_NOT_ENABLED",
          "ROUTE_NOT_FOUND",
          "METHOD_NOT_ALLOWED",
          "REQUEST_BODY_NOT_ALLOWED",
          "TARGET_TOO_LONG",
          "SNAPSHOT_CHANGED",
          "PROJECTION_BUSY",
          "PROJECTION_DEADLINE",
          "WARMING",
          "VERIFICATION_UNAVAILABLE",
          "PUBLICATION_UNAVAILABLE",
          "UPSTREAM_UNAVAILABLE",
          "UPSTREAM_INVALID",
          "INVALID_OWNER_PROJECTION",
          "VERIFICATION_EXPIRED",
          "PUBLICATION_NOT_CURRENT"
        ]
      },
      "minItems": 0,
      "maxItems": 4,
      "uniqueItems": true
    },
    "Lane": {
      "enum": [
        "SPOT",
        "FUTURES",
        "PROXY",
        "MIXED",
        "UNAVAILABLE"
      ]
    },
    "Cursor": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^[A-Za-z0-9_-]+$",
      "description": "Opaque to consumers. No decoding or token synthesis."
    },
    "Pair": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "family_id",
        "lane"
      ],
      "properties": {
        "family_id": {
          "$ref": "urn:rsibot:v5-lfl:stage-a:r2:common#/$defs/Id"
        },
        "lane": {
          "enum": [
            "SPOT",
            "FUTURES",
            "PROXY",
            "MIXED"
          ]
        }
      }
    },
    "Scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope_id",
        "scope_sha256",
        "program_id",
        "family_lane_pairs"
      ],
      "properties": {
        "scope_id": {
          "$ref": "urn:rsibot:v5-lfl:stage-a:r2:common#/$defs/Id"
        },
        "scope_sha256": {
          "$ref": "urn:rsibot:v5-lfl:stage-a:r2:common#/$defs/Hash"
        },
        "program_id": {
          "$ref": "urn:rsibot:v5-lfl:stage-a:r2:common#/$defs/Id"
        },
        "family_lane_pairs": {
          "type": "array",
          "items": {
            "$ref": "urn:rsibot:v5-lfl:stage-a:r2:common#/$defs/Pair"
          },
          "minItems": 1,
          "maxItems": 4,
          "uniqueItems": true
        }
      }
    },
    "Window": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "x-maxUtf8Bytes": 128
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "start",
            "end_exclusive"
          ],
          "properties": {
            "start": {
              "$ref": "urn:rsibot:v5-lfl:stage-a:r2:common#/$defs/TimeMs"
            },
            "end_exclusive": {
              "$ref": "urn:rsibot:v5-lfl:stage-a:r2:common#/$defs/TimeMs"
            }
          }
        }
      ]
    },
    "RecordedScope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "venue",
        "capital_model",
        "window",
        "regimes",
        "scope_state"
      ],
      "properties": {
        "venue": {
          "type": "string",
          "maxLength": 128,
          "x-maxUtf8Bytes": 128
        },
        "capital_model": {
          "type": "string",
          "maxLength": 128,
          "x-maxUtf8Bytes": 128
        },
        "window": {
          "anyOf": [
            {
              "$ref": "urn:rsibot:v5-lfl:stage-a:r2:common#/$defs/Window"
            },
            {
              "type": "null"
            }
          ]
        },
        "regimes": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 128,
            "x-maxUtf8Bytes": 128
          },
          "minItems": 0,
          "maxItems": 4,
          "uniqueItems": true
        },
        "scope_state": {
          "enum": [
            "RECORDED",
            "UNAVAILABLE"
          ]
        }
      }
    },
    "RowScope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "membership_basis",
        "family_id",
        "lane",
        "program_id",
        "recorded_scope"
      ],
      "properties": {
        "membership_basis": {
          "enum": [
            "LESSON_PROGRAM",
            "OWN_FAMILY_LANE",
            "EXPERIMENT_PARENT",
            "ASSERTED_PARENT"
          ]
        },
        "family_id": {
          "anyOf": [
            {
              "$ref": "urn:rsibot:v5-lfl:stage-a:r2:common#/$defs/Id"
            },
            {
              "type": "null"
            }
          ]
        },
        "lane": {
          "$ref": "urn:rsibot:v5-lfl:stage-a:r2:common#/$defs/Lane"
        },
        "program_id": {
          "anyOf": [
            {
              "$ref": "urn:rsibot:v5-lfl:stage-a:r2:common#/$defs/Id"
            },
            {
              "type": "null"
            }
          ]
        },
        "recorded_scope": {
          "anyOf": [
            {
              "$ref": "urn:rsibot:v5-lfl:stage-a:r2:common#/$defs/RecordedScope"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "SourceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "root",
        "relative_path",
        "pointer",
        "sha256",
        "bytes"
      ],
      "properties": {
        "root": {
          "enum": [
            "STORE",
            "OUTPUT",
            "SOURCE"
          ]
        },
        "relative_path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 192,
          "x-maxUtf8Bytes": 192,
          "x-path": "canonical relative POSIX; no empty/dot/dotdot/backslash/NUL/absolute components"
        },
        "pointer": {
          "type": "string",
          "maxLength": 96,
          "pattern": "^(|/.*)$",
          "x-maxUtf8Bytes": 96
        },
        "sha256": {
          "$ref": "urn:rsibot:v5-lfl:stage-a:r2:common#/$defs/Hash"
        },
        "bytes": {
          "$ref": "urn:rsibot:v5-lfl:stage-a:r2:common#/$defs/Counter"
        }
      }
    },
    "Ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "owner",
        "kind",
        "record_id",
        "revision",
        "source_index",
        "resolution"
      ],
      "properties": {
        "owner": {
          "enum": [
            "research_os",
            "hummingbot_api",
            "hummingbot"
          ]
        },
        "kind": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32,
          "x-maxUtf8Bytes": 32
        },
        "record_id": {
          "$ref": "urn:rsibot:v5-lfl:stage-a:r2:common#/$defs/Id"
        },
        "revision": {
          "anyOf": [
            {
              "$ref": "urn:rsibot:v5-lfl:stage-a:r2:common#/$defs/Hash"
            },
            {
              "type": "null"
            }
          ]
        },
        "source_index": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "resolution": {
          "enum": [
            "RESOLVED",
            "NOT_PUBLISHED",
            "UNAVAILABLE",
            "OUT_OF_SCOPE"
          ]
        }
      }
    },
    "Issue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "record_id",
        "detail"
      ],
      "properties": {
        "code": {
          "enum": [
            "MISSING_SOURCE",
            "SOURCE_CHANGED",
            "SCOPE_UNKNOWN",
            "UNSUPPORTED_NATIVE_SCHEMA",
            "OMITTED_CONTENT",
            "UNRESOLVED_REFERENCE",
            "CONTRADICTIONS_NOT_INDEXED",
            "COMPLETION_NOT_RECORDED",
            "INDEX_INCOMPLETE",
            "NOT_PUBLISHED",
            "CLOCK_SKEW"
          ]
        },
        "record_id": {
          "anyOf": [
            {
              "$ref": "urn:rsibot:v5-lfl:stage-a:r2:common#/$defs/Id"
            },
            {
              "type": "null"
            }
          ]
        },
        "detail": {
          "type": "string",
          "maxLength": 128,
          "x-maxUtf8Bytes": 128
        }
      }
    },
    "Coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "total_items",
        "omitted_items",
        "unresolved_membership_items",
        "excluded_proposed_edges",
        "pending_events",
        "returned_items"
      ],
      "properties": {
        "state": {
          "enum": [
            "COMPLETE",
            "PARTIAL",
            "UNAVAILABLE"
          ]
        },
        "total_items": {
          "anyOf": [
            {
              "$ref": "urn:rsibot:v5-lfl:stage-a:r2:common#/$defs/Counter"
            },
            {
              "type": "null"
            }
          ]
        },
        "omitted_items": {
          "anyOf": [
            {
              "$ref": "urn:rsibot:v5-lfl:stage-a:r2:common#/$defs/Counter"
            },
            {
              "type": "null"
            }
          ]
        },
        "unresolved_membership_items": {
          "anyOf": [
            {
              "$ref": "urn:rsibot:v5-lfl:stage-a:r2:common#/$defs/Counter"
            },
            {
              "type": "null"
            }
          ]
        },
        "excluded_proposed_edges": {
          "anyOf": [
            {
              "$ref": "urn:rsibot:v5-lfl:stage-a:r2:common#/$defs/Counter"
            },
            {
              "type": "null"
            }
          ]
        },
        "pending_events": {
          "anyOf": [
            {
              "$ref": "urn:rsibot:v5-lfl:stage-a:r2:common#/$defs/Counter"
            },
            {
              "type": "null"
            }
          ]
        },
        "returned_items": {
          "$ref": "urn:rsibot:v5-lfl:stage-a:r2:common#/$defs/Counter"
        }
      }
    },
    "Page": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "limit",
        "next_cursor",
        "has_more"
      ],
      "properties": {
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 50
        },
        "next_cursor": {
          "anyOf": [
            {
              "$ref": "urn:rsibot:v5-lfl:stage-a:r2:common#/$defs/Cursor"
            },
            {
              "type": "null"
            }
          ]
        },
        "has_more": {
          "type": "boolean"
        }
      }
    },
    "Capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "read",
        "dispatch",
        "activate",
        "release",
        "adopt",
        "recall"
      ],
      "properties": {
        "read": {
          "type": "boolean"
        },
        "dispatch": {
          "const": false
        },
        "activate": {
          "const": false
        },
        "release": {
          "const": false
        },
        "adopt": {
          "const": false
        },
        "recall": {
          "const": "NOT_EVALUATED"
        }
      }
    },
    "UnavailableRowStub": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_id",
        "native_kind",
        "native_revision",
        "row_scope",
        "recorded_at_ms",
        "available_at_ms",
        "sources",
        "row_status",
        "issues",
        "row_sha256"
      ],
      "properties": {
        "record_id": {
          "$ref": "urn:rsibot:v5-lfl:stage-a:r2:common#/$defs/Id"
        },
        "native_kind": {
          "enum": [
            "idea",
            "idea_revision",
            "experiment",
            "run",
            "assessment",
            "outcome",
            "decision",
            "evidence",
            "metrics",
            "report",
            "artifact_bundle",
            "edge"
          ]
        },
        "native_revision": {
          "anyOf": [
            {
              "$ref": "urn:rsibot:v5-lfl:stage-a:r2:common#/$defs/Hash"
            },
            {
              "type": "null"
            }
          ]
        },
        "row_scope": {
          "$ref": "urn:rsibot:v5-lfl:stage-a:r2:common#/$defs/RowScope"
        },
        "recorded_at_ms": {
          "anyOf": [
            {
              "$ref": "urn:rsibot:v5-lfl:stage-a:r2:common#/$defs/TimeMs"
            },
            {
              "type": "null"
            }
          ]
        },
        "available_at_ms": {
          "anyOf": [
            {
              "$ref": "urn:rsibot:v5-lfl:stage-a:r2:common#/$defs/TimeMs"
            },
            {
              "type": "null"
            }
          ]
        },
        "sources": {
          "type": "array",
          "items": {
            "$ref": "urn:rsibot:v5-lfl:stage-a:r2:common#/$defs/SourceRef"
          },
          "minItems": 1,
          "maxItems": 2
        },
        "row_status": {
          "const": "UNAVAILABLE"
        },
        "issues": {
          "type": "array",
          "items": {
            "$ref": "urn:rsibot:v5-lfl:stage-a:r2:common#/$defs/Issue"
          },
          "minItems": 1,
          "maxItems": 2
        },
        "row_sha256": {
          "$ref": "urn:rsibot:v5-lfl:stage-a:r2:common#/$defs/Hash"
        }
      }
    },
    "Lesson": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_id",
        "native_kind",
        "native_revision",
        "row_scope",
        "recorded_at_ms",
        "available_at_ms",
        "sources",
        "row_status",
        "issues",
        "row_sha256",
        "lesson_id",
        "program_id",
        "title",
        "statement",
        "reopening_condition",
        "domain",
        "confidence",
        "evidence_state",
        "supersedes",
        "outcome_refs",
        "recall",
        "contradiction_state",
        "contradictory_refs",
        "reference_total"
      ],
      "properties": {
        "record_id": {
          "$ref": "urn:rsibot:v5-lfl:stage-a:r2:common#/$defs/Id"
        },
        "native_kind": {
          "const": "decision"
        },
        "native_revision": {
          "anyOf": [
            {
              "$ref": "urn:rsibot:v5-lfl:stage-a:r2:common#/$defs/Hash"
            },
            {
              "type": "null"
            }
          ]
        },
        "row_scope": {
          "$ref": "urn:rsibot:v5-lfl:stage-a:r2:common#/$defs/RowScope"
        },
        "recorded_at_ms": {
          "anyOf": [
            {
              "$ref": "urn:rsibot:v5-lfl:stage-a:r2:common#/$defs/TimeMs"
            },
            {
              "type": "null"
            }
          ]
        },
        "available_at_ms": {
          "anyOf": [
            {
              "$ref": "urn:rsibot:v5-lfl:stage-a:r2:common#/$defs/TimeMs"
            },
            {
              "type": "null"
            }
          ]
        },
        "sources": {
          "type": "array",
          "items": {
            "$ref": "urn:rsibot:v5-lfl:stage-a:r2:common#/$defs/SourceRef"
          },
          "minItems": 1,
          "maxItems": 2
        },
        "row_status": {
          "enum": [
            "COMPLETE",
            "PARTIAL"
          ]
        },
        "issues": {
          "type": "array",
          "items": {
            "$ref": "urn:rsibot:v5-lfl:stage-a:r2:common#/$defs/Issue"
          },
          "minItems": 0,
          "maxItems": 2
        },
        "row_sha256": {
          "$ref": "urn:rsibot:v5-lfl:stage-a:r2:common#/$defs/Hash"
        },
        "lesson_id": {
          "$ref": "urn:rsibot:v5-lfl:stage-a:r2:common#/$defs/Id"
        },
        "program_id": {
          "$ref": "urn:rsibot:v5-lfl:stage-a:r2:common#/$defs/Id"
        },
        "title": {
          "type": "string",
          "maxLength": 128,
          "x-maxUtf8Bytes": 128
        },
        "statement": {
          "type": "string",
          "maxLength": 512,
          "x-maxUtf8Bytes": 512
        },
        "reopening_condition": {
          "type": "string",
          "maxLength": 128,
          "x-maxUtf8Bytes": 128
        },
        "domain": {
          "enum": [
            "HYPOTHESIS",
            "IMPLEMENTATION",
            "DATA",
            "EXECUTION",
            "RESEARCH_PROCESS"
          ]
        },
        "confidence": {
          "enum": [
            "LOW",
            "MEDIUM",
            "HIGH"
          ]
        },
        "evidence_state": {
          "enum": [
            "VALID",
            "PROVISIONAL",
            "INVALID",
            "UNAVAILABLE"
          ]
        },
        "supersedes": {
          "anyOf": [
            {
              "$ref": "urn:rsibot:v5-lfl:stage-a:r2:common#/$defs/Ref"
            },
            {
              "type": "null"
            }
          ]
        },
        "outcome_refs": {
          "type": "array",
          "items": {
            "$ref": "urn:rsibot:v5-lfl:stage-a:r2:common#/$defs/Ref"
          },
          "minItems": 0,
          "maxItems": 4
        },
        "recall": {
          "const": "NOT_EVALUATED"
        },
        "contradiction_state": {
          "enum": [
            "RECORDED",
            "NOT_INDEXED",
            "UNAVAILABLE"
          ]
        },
        "contradictory_refs": {
          "type": "array",
          "items": {
            "$ref": "urn:rsibot:v5-lfl:stage-a:r2:common#/$defs/Ref"
          },
          "minItems": 0,
          "maxItems": 4
        },
        "reference_total": {
          "anyOf": [
            {
              "$ref": "urn:rsibot:v5-lfl:stage-a:r2:common#/$defs/Counter"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "RecordNode": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_id",
        "native_kind",
        "native_revision",
        "row_scope",
        "recorded_at_ms",
        "available_at_ms",
        "sources",
        "row_status",
        "issues",
        "row_sha256",
        "record_type",
        "kind",
        "title",
        "native_state",
        "summary",
        "identities"
      ],
      "properties": {
        "record_id": {
          "$ref": "urn:rsibot:v5-lfl:stage-a:r2:common#/$defs/Id"
        },
        "native_kind": {
          "enum": [
            "idea",
            "idea_revision",
            "experiment",
            "run",
            "assessment",
            "outcome",
            "decision",
            "evidence",
            "metrics",
            "report",
            "artifact_bundle"
          ]
        },
        "native_revision": {
          "anyOf": [
            {
              "$ref": "urn:rsibot:v5-lfl:stage-a:r2:common#/$defs/Hash"
            },
            {
              "type": "null"
            }
          ]
        },
        "row_scope": {
          "$ref": "urn:rsibot:v5-lfl:stage-a:r2:common#/$defs/RowScope"
        },
        "recorded_at_ms": {
          "anyOf": [
            {
              "$ref": "urn:rsibot:v5-lfl:stage-a:r2:common#/$defs/TimeMs"
            },
            {
              "type": "null"
            }
          ]
        },
        "available_at_ms": {
          "anyOf": [
            {
              "$ref": "urn:rsibot:v5-lfl:stage-a:r2:common#/$defs/TimeMs"
            },
            {
              "type": "null"
            }
          ]
        },
        "sources": {
          "type": "array",
          "items": {
            "$ref": "urn:rsibot:v5-lfl:stage-a:r2:common#/$defs/SourceRef"
          },
          "minItems": 1,
          "maxItems": 2
        },
        "row_status": {
          "enum": [
            "COMPLETE",
            "PARTIAL"
          ]
        },
        "issues": {
          "type": "array",
          "items": {
            "$ref": "urn:rsibot:v5-lfl:stage-a:r2:common#/$defs/Issue"
          },
          "minItems": 0,
          "maxItems": 2
        },
        "row_sha256": {
          "$ref": "urn:rsibot:v5-lfl:stage-a:r2:common#/$defs/Hash"
        },
        "record_type": {
          "const": "node"
        },
        "kind": {
          "enum": [
