{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:rsibot:v5-lfl:stage-a:r2:query-assessments",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "scope_id",
    "idea_revision_id"
  ],
  "properties": {
    "scope_id": {
      "$ref": "urn:rsibot:v5-lfl:stage-a:r2:common#/$defs/Id"
    },
    "limit": {
      "type": "string",
      "pattern": "^([1-9]|[1-4][0-9]|50)$"
    },
    "cursor": {
      "$ref": "urn:rsibot:v5-lfl:stage-a:r2:common#/$defs/Cursor"
    },
    "idea_revision_id": {
      "$ref": "urn:rsibot:v5-lfl:stage-a:r2:common#/$defs/Id"
    }
  }
}
